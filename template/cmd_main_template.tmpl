package main

import (
	"{{.Module}}/configuration"
	{{.PackageName}} "{{.Module}}"
{{- if .HasDatabase }}
	"{{.Module}}/internal/database"
{{- end }}
	//+codegen:import main:package
	"github.com/urfave/cli/v2"
	"log"
	"os"
	_ "time/tzdata"
)

// {{.ProjectName}} API.
//
// The OpenAPI spec is generated from the routes with `make openapi-gen` and
// served by Scalar at /docs.
func main() {
	app := &cli.App{
		Flags: []cli.Flag{
			&cli.StringFlag{
				Name:  "env",
				Value: "",
				Usage: "-env development/production",
			},
		},
		Action: func(c *cli.Context) error {
			env := c.String("env")
			if env == configuration.EnvProduction {
				configuration.Load(env)
			} else {
				configuration.Load(configuration.EnvDevelopment)
			}

{{- if .HasDatabase }}
			dbDriver := database.NewDatabaseDriver()
			defer dbDriver.Close()
{{- end }}
			//+codegen:func main:database

			apps := {{.PackageName}}.CreateApp({{if .HasDatabase}}dbDriver{{end}})
			apps.StartAPI()

			return nil
		},
	}
	err := app.Run(os.Args)
	if err != nil {
		log.Fatal(err)
	}
}